{
  "name": "winremoteops",
  "productName": "WinRemoteOps",
  "version": "1.0.0",
  "description": "Agentless macOS dashboard to monitor and manage remote Windows servers over WinRM.",
  "author": "WinRemoteOps",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "check:main": "node --check electron/main.js && node --check electron/preload.js && node --check electron/remote.js",
    "build:mac": "npm run build && electron-builder --mac dmg --universal",
    "build:mac-universal": "npm run build && electron-builder --mac --x64 --arm64 --universal"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "nodejs-winrm": "^1.1.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.winremoteops.app",
    "productName": "WinRemoteOps",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["electron/**/*", "renderer/**/*", "package.json"],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64", "universal"] },
        { "target": "zip", "arch": ["x64", "arm64", "universal"] }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "WinRemoteOps ${version}",
      "artifactName": "WinRemoteOps-${version}-${arch}.dmg",
      "background": "build/background.png",
      "iconSize": 96,
      "window": { "width": 600, "height": 400 },
      "contents": [
        { "x": 150, "y": 200, "type": "file" },
        { "x": 450, "y": 200, "type": "link", "path": "/Applications" }
      ]
    },
    "zip": { "artifactName": "WinRemoteOps-${version}-${arch}-portable.zip" }
  }
}
